[sub_resource type="GDScript" id="GDScript_r1j4a"]
script/source = "extends Node3D


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	get_parent().get_node(\"SubViewport/FaceCam\").position = global_position
	get_parent().get_node(\"SubViewport/FaceCam\").global_rotation = global_rotation
"

